title: FirstD
---

<<declare $speaker_name = "" >>

<<set $rand = random_range(1, 3)>>
<<if $rand == 1>>
    {$speaker_name}: Здорово, приятель!
<<elseif $rand == 2>>
    {$speaker_name}: Кто идет! А, это ты.
<<else>>
    {$speaker_name}: Хм? А, привет-привет.
<<endif>>

<<set $rand = random_range(1, 3)>>
<<if $rand == 1>>
    {$speaker_name}: Моё колено до сих пор болит после той стрелы...
<<elseif $rand == 2>>
    {$speaker_name}: На окраине города опять видели бандитов.
<<else>>
    {$speaker_name}: Скоро уши отвалятся.
<<endif>>

<<set $rand = random_range(1, 3)>>
<<if $rand == 1>>
    {$speaker_name}: Не нарушай закон.
<<elseif $rand == 2>>
    {$speaker_name}: Бывай.
<<else>>
    {$speaker_name}: Ну, удачи тебе в твоих делах.
<<endif>>
===
