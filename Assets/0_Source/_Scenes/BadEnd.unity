--- !u!114 &487434265
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 487434264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c867c98a5a7e54d46a5e9ab4deae4c5d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProloguePhone
  player: {fileID: 1908850174}
  intro: {fileID: 888627874}
  cam: {fileID: 1908850172}
  phone: {fileID: 2124672963}
  blackScreen: {fileID: 1406052951}
  instructionText: {fileID: 1696487046}
  fadeDuration: 0
  voiceoverVolume: 1
  steps:
  - text: "<i><b>\u0422\u0435\u043B\u0435\u0444\u043E\u043D</b></i>\r\n\r\n<color=#FF5555>\u0421
      \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0431\u0438\u0435\u043C \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u043C,
      \u0447\u0442\u043E \u0432\u044B \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438.</color>\r\n\u041E\u0434\u043D\u0430\u043A\u043E,
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435,
      \u0432 \u044D\u0442\u043E\u043C \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E
      \u0437\u0430\u0437\u043E\u0440\u043D\u043E\u0433\u043E. \u041A\u043E\u043D\u0435\u0446
      \u0441\u0432\u0435\u0442\u0430 \u0437\u0430\u0442\u0440\u043E\u043D\u0443\u043B
      \u0432\u0441\u0435\u0445 \u043D\u0430\u0441, \u0436\u0438\u0442\u044C, \u043A\u0430\u043A
      \u0440\u0430\u043D\u044C\u0448\u0435, \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F.\r\n<color=#FF5555>\u041D\u0430
      \u044D\u0442\u043E\u043C \u043C\u044B \u0441 \u0432\u0430\u043C\u0438 \u043F\u0440\u043E\u0449\u0430\u0435\u043C\u0441\u044F.</color>\r\n\u0423\u0434\u0430\u0447\u0438
      \u0432\u0430\u043C.\r\n"
    voiceover: {fileID: 8300000, guid: f2650793a5cba2d42bcd86f57f7f9278, type: 3}
    displayDuration: 0
    pauseAfter: 3
    fontSize: 0
  - text: "\u041F\u043E\u0435\u0437\u0434 \u0432\u044B\u0441\u0430\u0434\u0438\u043B
      \u0432\u0430\u0441 \u0443 \u0432\u043E\u0440\u043E\u0442, \u0432\u044B \u0441\u043C\u0435\u0448\u0430\u043B\u0438\u0441\u044C
      \u0441 \u0442\u043E\u043B\u043F\u043E\u0439 <color=#FF5555>\u201C\u0437\u0430\u0439\u0446\u0435\u0432\u201D</color>.\r\n\u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B \u2013 \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445.
      \u0412\u0430\u043C \u0442\u043E\u0436\u0435 \u043D\u0435\u043A\u0443\u0434\u0430
      \u0438\u0434\u0442\u0438 - \u043D\u0430 \u0434\u043E\u043F\u0443\u0441\u043A
      \u0432 \u0433\u043E\u0440\u043E\u0434 \u0434\u0435\u043D\u0435\u0433 \u043D\u0435
      \u0445\u0432\u0430\u0442\u0438\u043B\u043E.\r\n\u041E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
      \u043B\u0438\u0448\u044C \u0441 \u0437\u0430\u0432\u0438\u0441\u0442\u044C\u044E
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0441\u0442\u0440\u043E\u0439\u043D\u0443\u044E
      \u043A\u043E\u043B\u043E\u043D\u043D\u0443 \u043B\u044E\u0434\u0435\u0439,
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C
      \u0442\u0430\u043A\u0438\u0435 \u0436\u0435\u043B\u0430\u043D\u043D\u044B\u0435
      \u0431\u0438\u043B\u0435\u0442\u0438\u043A\u0438\u2026\r\n\u041A\u0442\u043E-\u0442\u043E
      \u0438\u0437 <color=#FF5555>\u201C\u0437\u0430\u0439\u0446\u0435\u0432\u201D</color>
      \u0432\u044B\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0435
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E
      \u0433\u0440\u043E\u043C\u0447\u0435 \u0434\u0440\u0443\u0433\u0438\u0445.\r\n\u0415\u0433\u043E
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0434\u0438\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043F\u043E\u0442\u043E\u043C
      \u0435\u0449\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E,
      \u0438 \u0432\u043E\u0442 \u0443\u0436\u0435 \u0432\u0441\u044F \u0442\u043E\u043B\u043F\u0430
      \u0437\u043B\u043E\u0431\u043D\u043E \u0433\u0443\u0434\u0438\u0442.\r\n\u041A\u0442\u043E-\u0442\u043E
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043E\u0440\u043E\u0434, \u0435\u0433\u043E \u043B\u043E\u0432\u0438\u0442
      \u043E\u0445\u0440\u0430\u043D\u0430, \u043D\u043E \u043D\u0430 \u0432\u0441\u0435\u0445
      \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445 \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432\u043D\u0443\u0442\u0440\u044C \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442.\r\n\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0434\u0430\u0432\u043A\u0430 \u0438 \u0441\u0443\u0435\u0442\u0430.\r\n\u041C\u0443\u0436\u0447\u0438\u043D\u0430,
      \u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443
      \u043E\u0442 \u0432\u0430\u0441, \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C \u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0442\u044C
      \u0441\u0435\u0431\u0435 \u0434\u043E\u0440\u043E\u0433\u0443 \u043D\u0430\u043F\u0440\u043E\u043B\u043E\u043C.\r\n\u0414\u0440\u0443\u0433\u0438\u0435
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442 \u0437\u0430 \u043D\u0438\u043C.
      \u0412\u0430\u0441 \u0442\u043E\u043B\u043A\u0430\u044E\u0442, <color=#FF5555>\u0432\u044B
      \u043F\u0430\u0434\u0430\u0435\u0442\u0435</color>.\r\n\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u0432\u0441\u0442\u0430\u0442\u044C, \u043D\u043E \u0447\u0443\u0436\u0438\u0435
      \u043D\u043E\u0433\u0438 \u0432\u0442\u0430\u043F\u0442\u044B\u0432\u0430\u044E\u0442
      \u0432\u0430\u0441 \u0432 \u043E\u0431\u0436\u0438\u0433\u0430\u044E\u0449\u0435
      \u0433\u043E\u0440\u044F\u0447\u0443\u044E \u043F\u044B\u043B\u044C.\r\n<color=#FF5555>\u0421
      \u0445\u0440\u0443\u0441\u0442\u043E\u043C \u043B\u043E\u043C\u0430\u044E\u0442\u0441\u044F
      \u0432\u0430\u0448\u0438 \u043A\u043E\u0441\u0442\u0438, \u043A\u0430\u043A
      \u0441\u0443\u0445\u0438\u0435 \u0432\u0435\u0442\u043A\u0438. \u041F\u043E\u0445\u043E\u0436\u0435,
      \u043A\u043E\u043D\u0435\u0446 \u0432\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u0435\u0442
      \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0431\u0435\u0441\u0441\u043B\u0430\u0432\u043D\u044B\u0439\u2026</color>\r\n"
    voiceover: {fileID: 8300000, guid: e95bd0a4c0b1e4a4d9154284766b6860, type: 3}
    displayDuration: 0
    pauseAfter: 0
    fontSize: 0
  - text: "<align=\"center\"><b>\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438</b></align>\r\n\r\n\u0410\u0431\u0435\u043B\u0435\u043D\u0446\u0435\u0432
      \u041C\u0430\u0440\u043A (\u0420\u0418\u0426\u041F 1 \u043A\u0443\u0440\u0441)
      \u2014 \u041A\u043E\u0434 \u0438 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430\r\n\r\n\u0421\u0430\u0431\u043B\u0438\u043D\u0430
      \u041C\u0430\u0440\u0438\u044F (\u0420\u0418\u0426\u041F 1 \u043A\u0443\u0440\u0441)
      \u2014 \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432
      \u0438 \u0440\u0430\u0431\u043E\u0442\u0430 \u0441 YARN\r\n\r\n\u041A\u0430\u0440\u043F\u0438\u0432
      \u041F\u043E\u043B\u0438\u043D\u0430 (\u0420\u0418\u0426\u041F 1 \u043A\u0443\u0440\u0441)
      \u2014 \u041C\u043E\u0434\u0435\u043B\u044C\u043A\u0438 NPC \u0438 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438\r\n\r\n\u0422\u0438\u0449\u0435\u043D\u043A\u043E
      \u0413\u043B\u0430\u0444\u0438\u0440\u0430 (\u0420\u0418\u0426\u041F 1 \u043A\u0443\u0440\u0441)
      \u2014 \u041F\u0440\u043E\u0434\u044E\u0441\u0435\u0440\r\n\r\n<align=\"center\"><b>\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430\u0448\u0438\u043C \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430\u043C</b></align>\r\n\r\n\u041F\u0435\u043D\u0437\u0435\u0432\u0430
      \u0410\u043D\u0430\u0441\u0442\u0430\u0441\u0438\u044F (\u0424\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442
      \u043A\u0440\u0435\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0439;
      \u0423\u041A\u0418 1 \u043A\u0443\u0440\u0441) \u2014 \u041E\u0437\u0432\u0443\u0447\u043A\u0430
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430\r\n\r\n\u041F\u0435\u043D\u0437\u0435\u0432
      \u0421\u0435\u0440\u0433\u0435\u0439 (\u041D\u0435\u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u044B\u0439
      \u043E\u0442\u0435\u0446) \u2014 \u041E\u0437\u0432\u0443\u0447\u043A\u0430
      \u041D\u0430\u0440\u0440\u0430\u0442\u043E\u0440\u0430 "
    voiceover: {fileID: 8300000, guid: 77d27a08df8c645438067794d78b8a61, type: 3}
    displayDuration: 0
    pauseAfter: 2
    fontSize: 42
  nextScene: 
